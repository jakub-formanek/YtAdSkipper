{
  "manifest_version": 2,
  "name": "YT Ad Skipper (soukromý)",
  "version": "0.1.2",
  "description": "Ztlumí, přetočí a přeskočí reklamy ve videích na YouTube a skryje reklamní dlaždice.",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-ad-skipper@jakub.formanek.name",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://music.youtube.com/*",
        "*://www.youtube-nocookie.com/*"
      ],
      "js": [
        "selectors.js",
        "content.js"
      ],
      "css": [
        "hide.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_title": "YT Ad Skipper",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  }
}
